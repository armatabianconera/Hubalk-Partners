# CRM zapisuje zapytanie przed wysłaniem opcjonalnego powiadomienia.
CRM_INBOUND_URL=https://app.hubalk.pl/api/crm/inbound
CRM_INQUIRY_SECRET=
CRM_SIWC_BYPASS_TOKEN=

# Powiadomienie e-mail jest opcjonalne. Formularz działa bez tych trzech wartości.
RESEND_API_KEY=
# Verified sender, for example Hubalk Partners <formularz@hubalk.pl>
CONTACT_FROM=
# Fixed destination mailbox; never supplied by the visitor
CONTACT_TO=
# Exact origins, comma-separated; add your Vercel URL if you use it
ALLOWED_ORIGINS=https://hubalk.pl,https://www.hubalk.pl
# Complete approved privacy notice including actual controller and contact details
PRIVACY_NOTICE=

# Approved versions in each language, displayed only on the matching form
PRIVACY_NOTICE_HU=
PRIVACY_NOTICE_SH=
PRIVACY_NOTICE_EN=
